#!/usr/bin/env bash

# Optimized runprog script for ARCHER2 / Cirrus
# Handles: u-dx690/run25, u-dx690 run25, u-dx690 25

# 1. Clean up inputs
suite_part=${1%/}  # Remove trailing slash

if [[ -z $2 ]]; then
    export workflow="$suite_part"
else
    # Remove "run" prefix if typed, then add it back cleanly
    run_part=${2#run}
    export workflow="${suite_part}/run${run_part}"
fi

# 2. Set directory path
target_dir="$HOME/cylc-run/$workflow/work"

if [ ! -d "$target_dir" ]; then
    echo "---> Error: Directory $target_dir not found <---"
    exit 1
fi

cd "$target_dir" || exit

# 3. Collect pe_output paths into associative arrays
declare -A latest_tasks
declare -A latest_cycles

while IFS= read -r pe_dir; do
    task_path=$(dirname "$pe_dir")
    
    task_name=$(basename "$(dirname "$task_path")")
    cycle_point=$(basename "$task_path")

    # If layout is reversed (cycle/task instead of task/cycle)
    if [[ ! "$cycle_point" =~ ^[0-9]{8}T[0-9]{4}Z$ ]]; then
        task_name=$(basename "$task_path")
        cycle_point=$(basename "$(dirname "$task_path")")
    fi

    # Filter for target tasks
    case "$task_name" in
        atmos*|coupled*|*fcst*)
            # Only update if no cycle point set yet OR if this cycle point is newer (greater string value)
            if [[ -z "${latest_cycles[$task_name]}" || "$cycle_point" > "${latest_cycles[$task_name]}" ]]; then
                latest_cycles["$task_name"]="$cycle_point"
                latest_tasks["$task_name"]="$pe_dir"
            fi
            ;;
    esac
done < <(find . -maxdepth 3 -type d -name "pe_output" 2>/dev/null)

# 4. Process and print only the latest cycle point per task
found_task=0

for task_name in "${!latest_tasks[@]}"; do
    pe_dir="${latest_tasks[$task_name]}"
    cycle_point="${latest_cycles[$task_name]}"

    found_task=1
    echo "task name is -------> ${task_name} (${cycle_point})"

    last_stat=$(grep -sh 'Atm_Step: Timestep' "$pe_dir"/*0 2>/dev/null | tail -n 1)

    if [[ -n "$last_stat" ]]; then
        echo "    $last_stat"
    else
        echo "      (Timestep info not found in pe_output/*0)"
    fi
done

if [[ $found_task -eq 0 ]]; then
    echo "---> No matching tasks or pe_output directories found in $workflow <---"
fi
