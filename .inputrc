# Bind Tab to cycle forward through options
TAB: menu-complete

# Bind Shift+Tab to cycle backward through options
"\e[Z": menu-complete-backward

# Show the full list of options on the first press instead of hiding them
set show-all-if-ambiguous on

# Enable vi mode mode indicators in prompt
set show-mode-in-prompt on

# Customize the prompt indicators (optional)
set vi-ins-mode-string "(ins) "
set vi-cmd-mode-string "(cmd) "
