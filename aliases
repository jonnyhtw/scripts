# Run a command on the most recently modified non-hidden entry.
_run_on_latest() {
    local command=$1 file latest=
    for file in *; do
        [[ -e $file || -L $file ]] || continue
        if [[ -z $latest || $file -nt $latest ]]; then
            latest=$file
        fi
    done
    if [[ -z $latest ]]; then
        printf 'No non-hidden entries found in %s\n' "$PWD" >&2
        return 1
    fi
    "$command" "./$latest"
}
vimlatest() { _run_on_latest vim; }
taillatest() { _run_on_latest tail; }
